<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-Referenzen werden gegen eine vorhandene 7DTD-Installation aufgeloest.
    In CI laedt SteamCMD den Dedicated Server (App 294420) und der Build wird mit
        dotnet build src/SnapBounty.csproj -c Release -p:GameRoot="$SERVER_ROOT"
    aufgerufen. Lokal (macOS) greifen die Default-Pfade unten.
  -->
  <PropertyGroup>
    <!-- GameRoot: in CI per -p:GameRoot=... gesetzt; lokal Auto-Detect. -->
    <GameRoot Condition="'$(GameRoot)' == '' and Exists('/home/steam/.steam/SteamApps/common/7 Days to Die Dedicated Server')">/home/steam/.steam/SteamApps/common/7 Days to Die Dedicated Server</GameRoot>
    <GameRoot Condition="'$(GameRoot)' == '' and Exists('/opt/7dtd')">/opt/7dtd</GameRoot>

    <!-- ManagedDir aus GameRoot ableiten (Server- oder Client-Layout) -->
    <ManagedDir Condition="'$(ManagedDir)' == '' and '$(GameRoot)' != '' and Exists('$(GameRoot)/7DaysToDieServer_Data/Managed')">$(GameRoot)/7DaysToDieServer_Data/Managed</ManagedDir>
    <ManagedDir Condition="'$(ManagedDir)' == '' and '$(GameRoot)' != '' and Exists('$(GameRoot)/7DaysToDie_Data/Managed')">$(GameRoot)/7DaysToDie_Data/Managed</ManagedDir>
    <!-- lokale macOS-Steam-Installation (Default fuer Entwicklung) -->
    <ManagedDir Condition="'$(ManagedDir)' == '' and Exists('$(HOME)/Library/Application Support/Steam/steamapps/common/7 Days To Die/7DaysToDie.app/Contents/Resources/Data/Managed')">$(HOME)/Library/Application Support/Steam/steamapps/common/7 Days To Die/7DaysToDie.app/Contents/Resources/Data/Managed</ManagedDir>

    <!-- Harmony: bevorzugt aus der Installation, sonst NuGet-Fallback (nur Build-Zeit) -->
    <HarmonyPath Condition="'$(HarmonyPath)' == '' and Exists('$(ManagedDir)/0Harmony.dll')">$(ManagedDir)/0Harmony.dll</HarmonyPath>
    <HarmonyPath Condition="'$(HarmonyPath)' == '' and '$(GameRoot)' != '' and Exists('$(GameRoot)/Mods/0_TFP_Harmony/0Harmony.dll')">$(GameRoot)/Mods/0_TFP_Harmony/0Harmony.dll</HarmonyPath>
    <HarmonyPath Condition="'$(HarmonyPath)' == '' and Exists('$(HOME)/Library/Application Support/Steam/steamapps/common/7 Days To Die/Mods/0_TFP_Harmony/0Harmony.dll')">$(HOME)/Library/Application Support/Steam/steamapps/common/7 Days To Die/Mods/0_TFP_Harmony/0Harmony.dll</HarmonyPath>

    <AssemblyName>SnapBounty</AssemblyName>
    <RootNamespace>SnapBounty</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <!-- Output ins Repo-Root /bin/Release (csproj liegt in src/) -->
    <OutputPath>$(MSBuildProjectDirectory)/../bin/Release</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- net48-Referenz-Assemblies, damit der Build plattformuebergreifend (Linux/macOS) klappt -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass" Condition="Exists('$(ManagedDir)/Assembly-CSharp-firstpass.dll')">
      <HintPath>$(ManagedDir)/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine" Condition="Exists('$(ManagedDir)/UnityEngine.dll')">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LogLibrary" Condition="Exists('$(ManagedDir)/LogLibrary.dll')">
      <HintPath>$(ManagedDir)/LogLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony" Condition="'$(HarmonyPath)' != ''">
      <HintPath>$(HarmonyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Lib.Harmony" Version="2.2.2" Condition="'$(HarmonyPath)' == ''" />
  </ItemGroup>

  <Target Name="FailIfGameDllsMissing" BeforeTargets="ResolveReferences"
          Condition="!Exists('$(ManagedDir)/Assembly-CSharp.dll') or !Exists('$(ManagedDir)/UnityEngine.CoreModule.dll')">
    <Error Text="7DTD-Build-Referenzen nicht gefunden (ManagedDir='$(ManagedDir)'). GameRoot auf eine gueltige Installation setzen oder -p:GameRoot=... in CI uebergeben." />
  </Target>

</Project>
